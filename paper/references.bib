	file = {PDF:C\:\\Users\\ASUS\\Zotero\\storage\\C8TCNK95\\Afriyie et al. - 2023 - A supervised machine learning algorithm for detecting and predicting fraud in credit card transactio.pdf:application/pdf},
}

